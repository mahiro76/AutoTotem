# AutoTotem language file - English (en-US)
# Placeholders: %s (in order) or %1$s, %2$s (by position)
# Color codes use §

# Plugin enable/disable logs
plugin-enabled=§aAutoTotem has been enabled
plugin-disabled=§cAutoTotem has been disabled

# General
command-only-player=§cThis command can only be executed by players

# enabled subcommand
enabled-query=§eAutoTotem status: %s
enabled-status-on=§aON
enabled-status-off=§cOFF
enabled-usage=§7Use /autototem enabled true|false to toggle
enabled-true=§aAutoTotem has been enabled
enabled-false=§cAutoTotem has been disabled
enabled-invalid=§cInvalid argument, please use true or false

# cooldowntime subcommand
cooldown-query=§eCurrent cooldown: §a%1$s tick§e (%2$s seconds)
cooldown-negative=§cCooldown cannot be negative
cooldown-set=§aCooldown set to §e%1$s tick§a (%2$s seconds)
cooldown-invalid=§cInvalid argument, please enter an integer (ticks)

# reload subcommand
reload-success=§aConfiguration reloaded

# Help
help-header=§6========== AutoTotem Help ==========
help-enabled=§e/autototem enabled true|false §7- Toggle auto totem
help-cooldown=§e/autototem cooldowntime [tick] §7- View/set trigger cooldown (20 ticks = 1 second)
help-reload=§e/autototem reload §7- Reload configuration file
help-help=§e/autototem help §7- Show help
